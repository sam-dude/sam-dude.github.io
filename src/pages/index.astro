---
import { getCollection } from 'astro:content';
import ObsidianLayout from '../layouts/ObsidianLayout.astro';

const posts = (await getCollection('posts')).sort((a, b) => 
  b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const roboticsPosts = posts.filter(p => (p.data.category || 'My Days at Robotics Lab') === 'My Days at Robotics Lab');
---

<ObsidianLayout 
  title="Tech Reflections | Personal Engineering Journal" 
  description="Personal reflective technical reports on robotics, systems, and engineering field notes."
  type="website"
>
  <div class="garden-index">
    <!-- Clean Minimalist Welcome Section -->
    <header class="garden-header">
      <h1 class="garden-title">Personal Reflections on Tech</h1>
      <p class="garden-subtitle">
        Reflective technical reports, hardware logs, and engineering notes.
      </p>
    </header>

    <!-- My Days at Robotics Lab Section -->
    <section class="folder-section">
      <div class="folder-header-bar">
        <span class="folder-tag">FOLDER</span>
        <h2 class="folder-title">📁 My Days at Robotics Lab</h2>
      </div>

      <div class="reports-list">
        {roboticsPosts.map(post => {
          const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
          });

          return (
            <article class="report-entry">
              <a href={`/posts/${post.id}`} class="report-link">
                <div class="report-row">
                  <h3 class="entry-title">{post.data.title}</h3>
                  <time class="entry-date" datetime={post.data.pubDate.toISOString()}>
                    {formattedDate}
                  </time>
                </div>
                <p class="entry-desc">{post.data.description}</p>
              </a>
            </article>
          );
        })}
      </div>
    </section>
  </div>
</ObsidianLayout>

<style>
  .garden-index {
    width: 100%;
    max-width: 760px;
  }

  .garden-header {
    margin-bottom: 3.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .garden-title {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--text-heading);
    line-height: 1.25;
    margin-bottom: 0.6rem;
    letter-spacing: -0.02em;
  }

  .garden-subtitle {
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--text-muted);
  }

  .folder-section {
    margin-top: 2rem;
  }

  .folder-header-bar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.25rem;
  }

  .folder-tag {
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--text-faint);
    letter-spacing: 0.08em;
  }

  .folder-title {
    font-size: 1.35rem;
    color: var(--text-heading);
    font-weight: 700;
    margin: 0;
  }

  .reports-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .report-entry {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
  }

  .report-entry:hover {
    border-color: var(--border-medium);
    transform: translateY(-1px);
  }

  .report-link {
    display: block;
    padding: 1.3rem 1.5rem;
    text-decoration: none;
  }

  .report-link:hover {
    text-decoration: none;
  }

  .report-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.4rem;
  }

  .entry-title {
    font-size: 1.28rem;
    font-weight: 700;
    color: var(--text-heading);
    margin: 0;
    transition: color var(--transition-fast);
  }

  .report-link:hover .entry-title {
    color: var(--text-accent);
  }

  .entry-date {
    font-size: 0.82rem;
    color: var(--text-faint);
    white-space: nowrap;
  }

  .entry-desc {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 640px) {
    .garden-title {
      font-size: 2rem;
    }
    .report-row {
      flex-direction: column;
      gap: 0.2rem;
    }
  }
</style>
