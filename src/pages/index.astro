---
import { getCollection } from 'astro:content';
import ObsidianLayout from '../layouts/ObsidianLayout.astro';

const posts = (await getCollection('posts')).sort((a, b) => 
  b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const evergreenCount = posts.filter(p => p.data.status === 'evergreen').length;
const growingCount = posts.filter(p => p.data.status === 'growing').length;
const seedlingCount = posts.filter(p => p.data.status === 'seedling').length;
---

<ObsidianLayout 
  title="Tech Reflections | Digital Garden & Field Notes" 
  description="Personal reflective technical reports on systems architecture, premature abstractions, distributed state, and runtime performance."
  type="website"
>
  <div class="garden-index">
    <!-- Obsidian Note Header -->
    <div class="note-meta-banner">
      <div class="breadcrumb">
        <span>Vault</span>
        <span class="sep">/</span>
        <span class="active-crumb">00 - Index.md</span>
      </div>

      <div class="garden-stats-strip">
        <span class="stat-pill"><span class="pill-dot green"></span> {evergreenCount} Evergreen</span>
        <span class="stat-pill"><span class="pill-dot yellow"></span> {growingCount} Growing</span>
        <span class="stat-pill"><span class="pill-dot blue"></span> {seedlingCount} Seedlings</span>
        <span class="stat-pill total">Total: {posts.length} Notes</span>
      </div>
    </div>

    <!-- Intro Card with Hand-Drawn Excalidraw Aesthetic -->
    <article class="garden-intro-card">
      <div class="intro-badge">📓 FIELD JOURNAL</div>
      <h1 class="garden-title">Personal Reflections on Tech</h1>
      <p class="garden-subtitle">
        Welcome to my digital garden of reflective technical reports. Here, I dissect architecture decisions, postmortems, consensus bugs, and mental models from shipping production software.
      </p>

      <div class="obsidian-callout callout-tip" style="margin-top: 1.5rem;">
        <div class="callout-header">
          <span class="callout-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>
          </span>
          <span class="callout-title">How To Explore This Garden</span>
        </div>
        <div class="callout-content">
          <p>This garden is arranged like an <strong>Obsidian Vault</strong>. Use the left explorer to browse folders, click on any <span class="internal-link"><span class="internal-link-bracket">[[</span>Wikilink<span class="internal-link-bracket">]]</span></span> to hop between concepts, or press <kbd style="background: var(--bg-surface); padding: 0.1rem 0.35rem; border-radius: 4px; border: 1px solid var(--border-subtle); font-size: 0.85em;">Ctrl+K</kbd> to open the Quick Switcher.</p>
        </div>
      </div>
    </article>

    <!-- Recent Technical Reports Grid -->
    <section class="reports-section">
      <div class="section-title-bar">
        <h2>Reflective Technical Reports</h2>
        <span class="section-hint">Chronological index</span>
      </div>

      <div class="reports-grid">
        {posts.map(post => {
          const statusIcons = { seedling: '🌱', growing: '🌿', evergreen: '🌲', retrospective: '📓' };
          const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'short',
            day: 'numeric'
          });

          return (
            <a href={`/posts/${post.id}`} class="report-card">
              <div class="report-card-header">
                <span class="report-status" title={`Status: ${post.data.status}`}>
                  {statusIcons[post.data.status] || '📄'} {post.data.status}
                </span>
                <time class="report-date" datetime={post.data.pubDate.toISOString()}>
                  {formattedDate}
                </time>
              </div>

              <h3 class="report-title">{post.data.title}</h3>
              <p class="report-description">{post.data.description}</p>

              <div class="report-card-footer">
                <div class="report-tags">
                  {post.data.tags.slice(0, 3).map(tag => (
                    <span class="mini-tag">#{tag}</span>
                  ))}
                </div>
                <span class="read-more-link">
                  Read Note →
                </span>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  </div>
</ObsidianLayout>

<style>
  .garden-index {
    width: 100%;
    max-width: 820px;
  }

  .note-meta-banner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: 2rem;
    font-size: 0.85rem;
  }

  .breadcrumb {
    color: var(--text-faint);
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .sep {
    opacity: 0.5;
  }

  .active-crumb {
    color: var(--text-accent);
    font-weight: 600;
  }

  .garden-stats-strip {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .stat-pill {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.76rem;
    color: var(--text-muted);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: 0.2rem 0.5rem;
    border-radius: 12px;
  }

  .pill-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .pill-dot.green { background: #10b981; }
  .pill-dot.yellow { background: #f59e0b; }
  .pill-dot.blue { background: #3b82f6; }

  /* Intro Card */
  .garden-intro-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 2.2rem;
    box-shadow: var(--shadow-sm);
    position: relative;
    overflow: hidden;
  }

  .garden-intro-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background: linear-gradient(90deg, var(--accent-primary), #3b82f6);
  }

  .intro-badge {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--text-accent);
    letter-spacing: 0.08em;
    margin-bottom: 0.6rem;
  }

  .garden-title {
    font-size: 2.4rem;
    font-weight: 800;
    color: var(--text-heading);
    line-height: 1.2;
    margin-bottom: 0.8rem;
    letter-spacing: -0.02em;
  }

  .garden-subtitle {
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--text-muted);
  }

  /* Reports List */
  .reports-section {
    margin-top: 3.5rem;
  }

  .section-title-bar {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 1.5rem;
    border-bottom: 1px dashed var(--border-subtle);
    padding-bottom: 0.5rem;
  }

  .section-title-bar h2 {
    font-size: 1.45rem;
    color: var(--text-heading);
    font-weight: 700;
  }

  .section-hint {
    font-size: 0.8rem;
    color: var(--text-faint);
  }

  .reports-grid {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .report-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.4rem 1.6rem;
    text-decoration: none;
    transition: all var(--transition-fast);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .report-card:hover {
    border-color: var(--border-active);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    text-decoration: none;
  }

  .report-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.78rem;
  }

  .report-status {
    text-transform: capitalize;
    color: var(--text-accent);
    font-weight: 600;
    background: var(--tag-bg);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    border: 1px solid var(--tag-border);
  }

  .report-date {
    color: var(--text-faint);
  }

  .report-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-heading);
    line-height: 1.35;
    transition: color var(--transition-fast);
  }

  .report-card:hover .report-title {
    color: var(--text-accent);
  }

  .report-description {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .report-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 0.5rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-subtle);
  }

  .report-tags {
    display: flex;
    gap: 0.4rem;
  }

  .mini-tag {
    font-size: 0.75rem;
    color: var(--text-faint);
    background: var(--bg-app);
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
  }

  .read-more-link {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-link);
  }

  @media (max-width: 640px) {
    .garden-title {
      font-size: 1.85rem;
    }
    .garden-stats-strip {
      display: none;
    }
    .garden-intro-card {
      padding: 1.5rem;
    }
  }
</style>
