---
import { getCollection } from 'astro:content';
import ObsidianLayout from '../../layouts/ObsidianLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const uniqueTags = Array.from(new Set(posts.flatMap(p => p.data.tags || [])));
  
  return uniqueTags.map(tag => ({
    params: { tag },
    props: {
      tag,
      posts: posts
        .filter(p => p.data.tags?.includes(tag))
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

const { tag, posts } = Astro.props;
---

<ObsidianLayout
  title={`#${tag} | Tag Archive`}
  description={`Reflective technical reports tagged with #${tag}`}
  type="website"
>
  <div class="tag-page-container">
    <div class="tag-header">
      <div class="tag-breadcrumb">
        <a href="/">Vault</a>
        <span class="sep">/</span>
        <span class="active-crumb">Tags</span>
      </div>

      <h1 class="tag-heading">
        <span class="hash">#</span>{tag}
      </h1>
      <p class="tag-desc">Showing {posts.length} note{posts.length > 1 ? 's' : ''} in the digital garden.</p>
    </div>

    <div class="tag-posts-list">
      {posts.map(post => {
        const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'short',
          day: 'numeric'
        });

        return (
          <a href={`/posts/${post.id}`} class="tag-post-card">
            <div class="card-meta">
              <span class="card-status">{post.data.status}</span>
              <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
            </div>
            <h2 class="card-title">{post.data.title}</h2>
            <p class="card-desc">{post.data.description}</p>
          </a>
        );
      })}
    </div>
  </div>
</ObsidianLayout>

<style>
  .tag-page-container {
    width: 100%;
    max-width: 780px;
  }

  .tag-header {
    margin-bottom: 2rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .tag-breadcrumb {
    font-size: 0.82rem;
    color: var(--text-faint);
    margin-bottom: 0.5rem;
  }

  .tag-breadcrumb a {
    color: var(--text-muted);
  }

  .sep {
    opacity: 0.4;
  }

  .tag-heading {
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--text-heading);
    margin-bottom: 0.35rem;
  }

  .hash {
    color: var(--text-accent);
  }

  .tag-desc {
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .tag-posts-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .tag-post-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.5rem;
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .tag-post-card:hover {
    border-color: var(--border-active);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.78rem;
    color: var(--text-faint);
    margin-bottom: 0.4rem;
  }

  .card-status {
    text-transform: capitalize;
    color: var(--text-accent);
    font-weight: 600;
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-heading);
    margin-bottom: 0.4rem;
  }

  .tag-post-card:hover .card-title {
    color: var(--text-accent);
  }

  .card-desc {
    font-size: 0.9rem;
    color: var(--text-muted);
  }
</style>
