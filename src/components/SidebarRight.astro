---
export interface HeadingItem {
  depth: number;
  slug: string;
  text: string;
}

export interface BacklinkItem {
  id: string;
  title: string;
  description: string;
}

export interface Props {
  headings?: HeadingItem[];
  backlinks?: BacklinkItem[];
}

const { headings = [], backlinks = [] } = Astro.props;

// Filter to h2 and h3
const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);
---

<aside class="outline-sidebar" id="outline-sidebar">
  <div class="outline-header">
    <div class="outline-title-bar">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="8" y1="6" x2="21" y2="6"/>
        <line x1="8" y1="12" x2="21" y2="12"/>
        <line x1="8" y1="18" x2="21" y2="18"/>
        <line x1="3" y1="6" x2="3.01" y2="6"/>
        <line x1="3" y1="12" x2="3.01" y2="12"/>
        <line x1="3" y1="18" x2="3.01" y2="18"/>
      </svg>
      <span>OUTLINE & CONTROLS</span>
    </div>
    <button id="close-right-sidebar" class="close-sidebar-btn" title="Close Outline">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>

  <div class="outline-container">
    {tocHeadings.length > 0 ? (
      <div class="outline-section">
        <ul class="toc-list">
          {tocHeadings.map(h => (
            <li class:list={['toc-item', `toc-depth-${h.depth}`]}>
              <a href={`#${h.slug}`} class="toc-link" data-slug={h.slug}>
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ) : (
      <div class="empty-outline">
        No sub-headings in this note
      </div>
    )}

    <!-- Linked Mentions / Backlinks -->
    {backlinks.length > 0 && (
      <div class="outline-section" style="margin-top: 1.5rem;">
        <div class="section-label">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
          </svg>
          <span>LINKED MENTIONS</span>
        </div>

        <ul class="backlink-list">
          {backlinks.map(link => (
            <li class="backlink-item">
              <a href={`/posts/${link.id}`} class="backlink-link">
                <span class="backlink-title">{link.title}</span>
                <span class="backlink-desc">{link.description}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

    <!-- Reading Adjuster Tools -->
    <div class="outline-section reading-tools" style="margin-top: 2rem;">
      <div class="section-label">
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="3"/>
          <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42"/>
          <path d="M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
        </svg>
        <span>READING SIZE</span>
      </div>
      <div class="reading-buttons">
        <button id="font-decrease" class="tool-chip" title="Decrease font size">A-</button>
        <button id="font-reset" class="tool-chip" title="Reset font size">Reset</button>
        <button id="font-increase" class="tool-chip" title="Increase font size">A+</button>
      </div>
    </div>
  </div>
</aside>

<style>
  .outline-sidebar {
    width: var(--sidebar-right-width);
    background: var(--bg-sidebar);
    border-left: 1px solid var(--border-subtle);
    height: calc(100vh - var(--header-height));
    position: fixed;
    right: 0;
    top: var(--header-height);
    bottom: 0;
    z-index: 150;
    overflow-y: auto;
    padding: 1rem;
    transform: translateX(100%); /* Collapsed by default */
    transition: transform var(--transition-normal);
    box-shadow: var(--shadow-lg);
  }

  .outline-sidebar.open {
    transform: translateX(0); /* Opened on toggle */
  }

  .outline-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: 1rem;
  }

  .outline-title-bar {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--text-faint);
    letter-spacing: 0.08em;
  }

  .close-sidebar-btn {
    background: transparent;
    border: none;
    color: var(--text-faint);
    cursor: pointer;
    padding: 0.25rem;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color var(--transition-fast);
  }

  .close-sidebar-btn:hover {
    color: var(--text-heading);
    background: var(--bg-surface-hover);
  }

  .section-label {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--text-faint);
    letter-spacing: 0.06em;
    margin-bottom: 0.6rem;
  }

  .toc-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .toc-depth-3 {
    padding-left: 0.85rem;
  }

  .toc-link {
    color: var(--text-muted);
    font-size: 0.82rem;
    text-decoration: none;
    line-height: 1.4;
    display: block;
    padding: 0.3rem 0.5rem;
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
    border-left: none; /* Clean: NO BORDER-LEFT */
  }

  .toc-link:hover {
    color: var(--text-heading);
    background: var(--bg-surface-hover);
    text-decoration: none;
  }

  .toc-link.active {
    color: var(--text-accent);
    background: var(--bg-surface-active);
    font-weight: 600;
    border-left: none; /* Clean: NO BORDER-LEFT */
  }

  .empty-outline {
    font-size: 0.8rem;
    color: var(--text-faint);
    font-style: italic;
    padding: 0.5rem 0;
  }

  .backlink-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .backlink-link {
    display: block;
    padding: 0.5rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .backlink-link:hover {
    border-color: var(--border-medium);
    text-decoration: none;
  }

  .backlink-title {
    display: block;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-main);
  }

  .backlink-desc {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 0.72rem;
    color: var(--text-faint);
    margin-top: 0.2rem;
  }

  .reading-buttons {
    display: flex;
    gap: 0.4rem;
  }

  .tool-chip {
    flex: 1;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
    padding: 0.35rem;
    font-size: 0.75rem;
    font-weight: 600;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .tool-chip:hover {
    background: var(--bg-surface-hover);
    color: var(--text-heading);
    border-color: var(--border-medium);
  }
</style>

<script is:inline>
  // Close right sidebar button
  const closeRightBtn = document.getElementById('close-right-sidebar');
  const rightSidebar = document.getElementById('outline-sidebar');
  if (closeRightBtn && rightSidebar) {
    closeRightBtn.addEventListener('click', () => {
      rightSidebar.classList.remove('open');
    });
  }

  // Scrollspy for active outline heading
  (function() {
    const links = document.querySelectorAll('.toc-link');
    if (!links.length) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('id');
          links.forEach(l => {
            if (l.getAttribute('data-slug') === id) {
              l.classList.add('active');
            } else {
              l.classList.remove('active');
            }
          });
        }
      });
    }, { rootMargin: '0px 0px -70% 0px' });

    document.querySelectorAll('.markdown-body h2, .markdown-body h3').forEach(heading => {
      observer.observe(heading);
    });

    // Font size controls
    let baseSize = 17;
    const decBtn = document.getElementById('font-decrease');
    const resetBtn = document.getElementById('font-reset');
    const incBtn = document.getElementById('font-increase');

    if (decBtn && incBtn && resetBtn) {
      decBtn.addEventListener('click', () => {
        if (baseSize > 14) {
          baseSize -= 1;
          document.documentElement.style.fontSize = baseSize + 'px';
        }
      });
      incBtn.addEventListener('click', () => {
        if (baseSize < 22) {
          baseSize += 1;
          document.documentElement.style.fontSize = baseSize + 'px';
        }
      });
      resetBtn.addEventListener('click', () => {
        baseSize = 17;
        document.documentElement.style.fontSize = '17px';
      });
    }
  })();
</script>
