---
import type { CollectionEntry } from 'astro:content';

export interface Props {
  posts: CollectionEntry<'posts'>[];
}

const { posts = [] } = Astro.props;

const searchIndex = posts.map(p => ({
  id: p.id,
  title: p.data.title,
  description: p.data.description,
  tags: p.data.tags || [],
  category: p.data.category || 'Reflections',
  status: p.data.status || 'seedling'
}));
---

<div id="quick-switcher-modal" class="modal-backdrop hidden" role="dialog" aria-modal="true">
  <div class="modal-card">
    <div class="search-input-wrapper">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      <input 
        type="text" 
        id="quick-switcher-input" 
        placeholder="Type a note title, concept, or #tag..." 
        autocomplete="off" 
        spellcheck="false"
      />
      <kbd class="esc-badge">ESC</kbd>
    </div>

    <div class="search-results-list" id="quick-switcher-results">
      <!-- Injected dynamically -->
    </div>

    <div class="modal-footer">
      <div class="footer-tip">
        <span><kbd>↑</kbd> <kbd>↓</kbd> navigate</span>
        <span><kbd>↵</kbd> open</span>
        <span><kbd>esc</kbd> close</span>
      </div>
    </div>
  </div>
</div>

<style>
  .modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(4px);
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding-top: 12vh;
    z-index: 1000;
  }

  .modal-backdrop.hidden {
    display: none !important;
  }

  .modal-card {
    width: 100%;
    max-width: 620px;
    background: var(--bg-surface);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-modal);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    animation: modalSlide 0.15s ease-out;
  }

  @keyframes modalSlide {
    from { opacity: 0; transform: translateY(-8px) scale(0.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  .search-input-wrapper {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.9rem 1.25rem;
    border-bottom: 1px solid var(--border-subtle);
    color: var(--text-muted);
  }

  .search-input-wrapper input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    font-size: 1.05rem;
    font-family: inherit;
    color: var(--text-heading);
  }

  .esc-badge {
    background: var(--bg-app);
    border: 1px solid var(--border-subtle);
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    font-size: 0.7rem;
    color: var(--text-faint);
  }

  .search-results-list {
    max-height: 380px;
    overflow-y: auto;
    padding: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  :global(.search-result-item) {
    display: flex;
    flex-direction: column;
    padding: 0.65rem 0.85rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: background var(--transition-fast);
    border: 1px solid transparent;
  }

  :global(.search-result-item:hover),
  :global(.search-result-item.selected) {
    background: var(--bg-surface-hover);
    border-color: var(--border-subtle);
    text-decoration: none;
  }

  :global(.search-result-title) {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-heading);
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  :global(.search-result-desc) {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-top: 0.2rem;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  :global(.search-result-tags) {
    display: flex;
    gap: 0.35rem;
    margin-top: 0.35rem;
  }

  :global(.search-mini-tag) {
    font-size: 0.7rem;
    color: var(--tag-text);
    background: var(--tag-bg);
    padding: 0.05rem 0.35rem;
    border-radius: 3px;
  }

  .modal-footer {
    padding: 0.6rem 1.25rem;
    background: var(--bg-sidebar);
    border-top: 1px solid var(--border-subtle);
  }

  .footer-tip {
    display: flex;
    gap: 1rem;
    font-size: 0.75rem;
    color: var(--text-faint);
  }

  .footer-tip kbd {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: 0.1rem 0.35rem;
    border-radius: 3px;
    font-size: 0.72rem;
  }
</style>

<script is:inline define:vars={{ searchIndex }}>
  (function() {
    const modal = document.getElementById('quick-switcher-modal');
    const input = document.getElementById('quick-switcher-input');
    const resultsContainer = document.getElementById('quick-switcher-results');
    const triggerBtn = document.getElementById('search-trigger');
    let selectedIndex = 0;

    function openModal() {
      if (!modal || !input) return;
      modal.classList.remove('hidden');
      input.value = '';
      renderResults(searchIndex);
      setTimeout(() => input.focus(), 50);
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.add('hidden');
    }

    if (triggerBtn) {
      triggerBtn.addEventListener('click', openModal);
    }

    // Hotkey: Cmd+K / Ctrl+K
    window.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (modal.classList.contains('hidden')) {
          openModal();
        } else {
          closeModal();
        }
      } else if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });

    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });
    }

    // Filter results
    if (input) {
      input.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase().trim();
        if (!query) {
          renderResults(searchIndex);
          return;
        }

        const filtered = searchIndex.filter(item => {
          const matchTitle = item.title.toLowerCase().includes(query);
          const matchDesc = item.description.toLowerCase().includes(query);
          const matchTags = item.tags.some(t => t.toLowerCase().includes(query));
          return matchTitle || matchDesc || matchTags;
        });

        renderResults(filtered);
      });

      // Keyboard navigation
      input.addEventListener('keydown', (e) => {
        const items = resultsContainer.querySelectorAll('.search-result-item');
        if (!items.length) return;

        if (e.key === 'ArrowDown') {
          e.preventDefault();
          selectedIndex = (selectedIndex + 1) % items.length;
          updateSelection(items);
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          selectedIndex = (selectedIndex - 1 + items.length) % items.length;
          updateSelection(items);
        } else if (e.key === 'Enter') {
          e.preventDefault();
          if (items[selectedIndex]) {
            items[selectedIndex].click();
          }
        }
      });
    }

    function updateSelection(items) {
      items.forEach((item, idx) => {
        if (idx === selectedIndex) {
          item.classList.add('selected');
          item.scrollIntoView({ block: 'nearest' });
        } else {
          item.classList.remove('selected');
        }
      });
    }

    function renderResults(list) {
      if (!resultsContainer) return;
      selectedIndex = 0;

      if (!list.length) {
        resultsContainer.innerHTML = `
          <div style="padding: 1.5rem; text-align: center; color: var(--text-faint); font-size: 0.9rem;">
            No matching notes found
          </div>
        `;
        return;
      }

      const statusMap = { seedling: '🌱', growing: '🌿', evergreen: '🌲', retrospective: '📓' };

      resultsContainer.innerHTML = list.map((item, idx) => `
        <a href="/posts/${item.id}" class="search-result-item ${idx === 0 ? 'selected' : ''}">
          <div class="search-result-title">
            <span>${statusMap[item.status] || '📄'}</span>
            <span>${escape(item.title)}</span>
          </div>
          <div class="search-result-desc">${escape(item.description)}</div>
          <div class="search-result-tags">
            ${item.tags.map(t => `<span class="search-mini-tag">#${escape(t)}</span>`).join('')}
          </div>
        </a>
      `).join('');

      function escape(str) {
        return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
      }
    }
  })();
</script>
